{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx prisma generate && npx tsc -p tsconfig.build.json"
  },
  "deploy": {
    "startCommand": "node dist/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 30
  }
}
