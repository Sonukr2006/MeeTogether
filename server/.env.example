PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/meetogether?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/meetogether?sslmode=require"
JWT_ACCESS_SECRET="replace-with-a-long-random-development-secret"
JWT_ACCESS_TTL="15m"
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SAME_SITE="lax"
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
APP_BASE_URL="http://localhost:5173"
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@meetogether.dev"
RESEND_API_KEY="replace-with-resend-api-key-when-email-provider-is-resend"
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5174"
STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="meetogether-media"
AWS_REGION=""
AWS_ACCESS_KEY_ID="replace-with-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="replace-with-aws-secret-access-key"
S3_BUCKET_NAME="meetogether-media"
CLOUDFRONT_BASE_URL="https://cdn.example.com"
S3_UPLOAD_URL_TTL_SECONDS=300
LIKE_WRITE_PROVIDER="direct"
UPSTASH_REDIS_REST_URL="https://example-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
LIKE_QUEUE_POLL_INTERVAL_MS=750
LIKE_QUEUE_TTL_SECONDS=300
